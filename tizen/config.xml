<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://plexarctic.local/app" version="0.70.5" viewmodes="maximized">
    <tizen:application id="PlxArctic1.PlexArctic" package="PlxArctic1" required_version="2.3"/>
    <name>PLEX:arctic</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; connect-src * data: blob:; font-src * data:; frame-src *</tizen:content-security-policy>
    <!-- Smart Hub preview: a row of posters on the TV's home screen; tiles open the title in the app -->
    <tizen:metadata key="http://samsung.com/tv/metadata/use.preview" value="bg_service"/>
    <tizen:app-control>
        <tizen:src name="index.html" reload="disable"/>
        <tizen:operation name="http://samsung.com/appcontrol/operation/eden_resume"/>
    </tizen:app-control>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:service id="PlxArctic1.service" auto-restart="false" on-boot="false">
        <tizen:content src="service/service.js"/>
        <tizen:name>PLEX:arctic preview</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Puts Continue watching and Recently added on the TV home screen</tizen:description>
        <tizen:category name="http://tizen.org/category/service"/>
    </tizen:service>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
